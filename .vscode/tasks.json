{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build EXE",
      "type": "shell",
      "command": "python -m PyInstaller tasker.spec --noconfirm",
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Build Installer",
      "type": "process",
      "command": "cmd",
      "args": ["/c", "${workspaceFolder}\\build.bat"],
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
